XMTP_ENV=dev # local, dev, production
WALLET_KEY= # the private key for the wallet
ENCRYPTION_KEY= # the encryption key for the wallet
# public key is 0x..

OPENAI_API_KEY= # the API key for the OpenAI node
AGENT_ENDPOINT=http://127.0.0.1:8000/inbox

# Debug mode - shows trace URLs in responses for debugging
# Set to true to include trace URLs in XMTP messages
# Set to false for production to hide trace URLs from end users
# Default: false
DEBUG_MODE=false
BOT_MENTION_ALIASES