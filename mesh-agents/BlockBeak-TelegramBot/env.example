# Core AI Configuration
MODEL_PROVIDER=openai
API_KEY=your_openai_api_key_here
MODEL=gpt-5-mini
TEMPERATURE=0.1
MAX_TOKENS=500000
MCP_SSE_URL=your_mcp_sse_url_here

# Debug Configuration
DEBUG_MODE=false

# Agent Turn Limits (optional)
# Maximum number of AI turns (tool calls) for different analysis modes
MAX_TURNS_NORMAL=20   # For standard queries
MAX_TURNS_DEEP=50     # For deep analysis queries

# Telegram Configuration (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
# Optional: Comma-separated chat IDs that should see trace URLs for debugging
# If not set, trace URLs follow the global DEBUG_MODE setting
TELEGRAM_DEBUG_CHAT_ID=chat_id_1,chat_id_2

# XMTP Configuration (for Node.js side)
WALLET_KEY=your_wallet_private_key_here
ENCRYPTION_KEY=your_encryption_key_here
XMTP_ENV=dev
AGENT_ENDPOINT=http://127.0.0.1:8000/inbox

# XMTP Concurrency Configuration (Option 2: Per-conversation chaining)
# Messages within each conversation are processed sequentially to prevent out-of-order replies
# Maximum number of concurrent agent requests across all conversations (default: 8)
AGENT_CONCURRENCY=8
# Timeout for agent requests in milliseconds (default: 180000 = 180 seconds)
AGENT_REQUEST_TIMEOUT=180000

# XMTP API Server Configuration (optional)
XMTP_API_HOST=127.0.0.1
XMTP_API_PORT=8000
XMTP_API_RELOAD=false

# Session Memory Configuration (optional)
SESSION_STORAGE_TYPE=sqlite
SESSION_DB_PATH=./data/sessions.db
REDIS_URL=redis://localhost:6379

# Session Behavior (optional)
SESSION_MAX_ITEMS=50
SESSION_WINDOW_SIZE=20
SESSION_TTL_HOURS=168

# Performance (optional)
SESSION_CACHE_ENABLED=true
SESSION_CACHE_TTL=300